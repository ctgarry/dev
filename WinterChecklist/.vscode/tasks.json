{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zip: Retail → CurseForge",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.tools/build.ps1",
        "-Flavor", "retail",
        "-Mode", "zip"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Zip: Classic Era → CurseForge",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.tools/build.ps1",
        "-Flavor", "classic_era",
        "-Mode", "zip"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Install: Classic Era (live AddOns)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.tools/build.ps1",
        "-Flavor", "classic_era",
        "-Mode", "install"
      ],
      "problemMatcher": []
    },
    {
      "label": "Install: Retail (live AddOns)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/.tools/build.ps1",
        "-Flavor", "retail",
        "-Mode", "install"
      ],
      "problemMatcher": []
    },
    { "label": "fmt:stylua", "type": "shell", "command": "stylua ." },
    { "label": "lint:luacheck", "type": "shell", "command": "luacheck . --codes --exclude-files \"lib/**\"" },
    { "label": "fmt+lint", "dependsOn": ["fmt:stylua","lint:luacheck"], "dependsOrder": "sequence" }
  ]
}
